# {{ ansible_managed }}
# NIS2 / Paragraph 30 BSIG - OpenSSL-Haertung, Gegenstueck zur Subpolicy NIS2-HARDENED (roles/encryption)
# Wird nach dem crypto-config-Profil eingelesen und hat damit Vorrang.
[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
{# Das crypto-config-Profil 'future' (ab 26.04) verlangt TLS 1.3 — nicht durch das Drop-in abschwaechen. #}
{% set future = __encryption_profile == 'future' and ansible_distribution_version is version('26.04', '>=') %}
MinProtocol = {{ 'TLSv1.3' if future else encryption_ubuntu_tls_min_protocol }}
CipherString = {{ encryption_ubuntu_tls_cipher_string }}
